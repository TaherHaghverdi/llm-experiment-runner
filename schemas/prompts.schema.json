{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TaherHaghverdi/llm-experiment-runner/schemas/prompts.schema.json",
  "title": "LLM Experiment Runner prompt set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "group",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
