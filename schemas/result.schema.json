{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TaherHaghverdi/llm-positioning-runner/schemas/result.schema.json",
  "title": "LLM Positioning Runner result attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "attempt_sequence",
    "job_id",
    "run_id",
    "experiment_name",
    "provider",
    "model_id",
    "model",
    "condition",
    "prompt",
    "repetition",
    "started_at",
    "completed_at",
    "latency_ms",
    "request_attempts",
    "status",
    "response",
    "usage",
    "estimated_cost_usd",
    "web",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_name": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "google"
      ]
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "enum": [
        "plain",
        "web"
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "request_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "success",
        "error"
      ]
    },
    "response": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "finish_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "estimated_cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "web": {
      "type": "object",
      "required": [
        "searched",
        "search_count",
        "queries",
        "sources"
      ],
      "properties": {
        "searched": {
          "type": "boolean"
        },
        "search_count": {
          "type": "integer",
          "minimum": 0
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "title"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
